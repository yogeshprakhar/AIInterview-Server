{
  "compilerOptions": {
    "outDir": "./dist",     // ← compiled files go here
    "rootDir": "./src",     // ← source files are here
    "module": "commonjs",
    "target": "ES2020",
    "esModuleInterop": true,
    "strict": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"],
  "skipLibCheck": true   
}